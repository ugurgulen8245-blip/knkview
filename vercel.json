{
  "functions": {
    "api/*.js": { "maxDuration": 15 },
    "api/scan.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/lib/(.*).mjs", "headers": [ { "key": "Content-Type", "value": "text/javascript; charset=utf-8" } ] }
  ]
}
